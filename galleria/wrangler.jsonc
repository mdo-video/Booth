{
  // il nome deve restare uguale a quello del Worker già creato su Cloudflare (mdo-booth)
  "name": "mdo-booth",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "r2_buckets": [
    { "binding": "BUCKET", "bucket_name": "booth-media" }
  ],
  "observability": { "enabled": true }
}
